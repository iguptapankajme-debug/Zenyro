# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://zenyro.in

# Lead notifications via Resend (https://resend.com). Leave blank to disable email.
RESEND_API_KEY=
LEAD_NOTIFY_TO=hello@zenyro.in
LEAD_NOTIFY_FROM="Zenyro Website <leads@zenyro.in>"

# Lead storage in Supabase (optional). Run supabase/schema.sql first.
# Use the service role key: it is only read on the server and never sent to the browser.
# The Vercel–Supabase integration sets these automatically (NEXT_PUBLIC_SUPABASE_URL also works).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forward each lead to a CRM or automation tool (optional), e.g. a HubSpot, Zoho, Make or n8n webhook.
CRM_WEBHOOK_URL=

# Google Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Privacy-friendly analytics with Plausible (optional): the domain registered in Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Lead admin at /admin/leads (requires Supabase above). Leave blank to keep the admin disabled.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. from: openssl rand -base64 48
ADMIN_SESSION_SECRET=
